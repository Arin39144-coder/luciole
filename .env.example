# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_SECRET_KEY=change-me-to-another-long-random-secret-key

# Database (local Docker)
DATABASE_URL=mysql+pymysql://luciole:luciole_pass@db:3306/luciole

# Database (Aiven MySQL production)
# DATABASE_URL=mysql+pymysql://user:password@host:port/defaultdb?ssl_ca=/path/to/ca.pem

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,chrome-extension://YOUR_EXTENSION_ID

# Dashboard
DASHBOARD_URL=http://localhost:5000

# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=luciole
MYSQL_USER=luciole
MYSQL_PASSWORD=luciole_pass
